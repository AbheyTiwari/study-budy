{
  "manifest_version": 3,
  "name": "Study Buddy Tab Enforcer",
  "version": "1.0",
  "description": "Closes distraction tabs on command from Study Buddy desktop app.",
  "permissions": ["tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Study Buddy Active",
    "default_icon": "icon.png"
  }
}
